{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["bun"],
		"resolveJsonModule": true,
		"verbatimModuleSyntax": true,
		"jsx": "react-jsx"
	},
	"include": ["src", "test", "example"]
}

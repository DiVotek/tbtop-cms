{
	"name": "@tbtop/cms",
	"version": "0.0.0",
	"description": "Code-first site CMS for Bun, Node and Cloudflare Workers: pages, blocks and SEO over Kysely, edited in @tbtop/admin.",
	"license": "MIT",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=20"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./catalog": {
			"types": "./dist/catalog.d.ts",
			"import": "./dist/catalog.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"setup:admin": "./scripts/fetch-admin.sh",
		"build": "tsup",
		"test": "bun test",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"zod": "^4.4.3"
	},
	"peerDependencies": {
		"@tbtop/admin": "*",
		"kysely": "^0.28.0"
	},
	"devDependencies": {
		"@tbtop/admin": "file:.tbtop/packages/node",
		"@types/bun": "^1.3.11",
		"kysely": "^0.28.2",
		"kysely-bun-sqlite": "^0.4.0",
		"typescript": "^5.9.0",
		"tsup": "^8.5.0"
	},
	"files": [
		"dist",
		"README.md"
	]
}

{
	"name": "@tbtop/cms",
	"version": "0.0.0",
	"description": "Code-first site CMS for Bun, Node and Cloudflare Workers: pages, blocks and SEO over Kysely, edited in @tbtop/admin.",
	"license": "MIT",
	"author": "DiVotek <support@divotek.com>",
	"homepage": "https://github.com/DiVotek/tbtop-cms/tree/main/packages/node#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DiVotek/tbtop-cms.git",
		"directory": "packages/node"
	},
	"bugs": {
		"url": "https://github.com/DiVotek/tbtop-cms/issues"
	},
	"keywords": [
		"cms",
		"headless-cms",
		"tbtop",
		"kysely",
		"cloudflare-workers",
		"bun"
	],
	"type": "module",
	"sideEffects": [
		"./dist/admin-client.js"
	],
	"bin": {
		"tbtop-cms": "./dist/cli.js"
	},
	"engines": {
		"node": ">=22"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./catalog": {
			"types": "./dist/catalog.d.ts",
			"import": "./dist/catalog.js"
		},
		"./react": {
			"types": "./dist/react.d.ts",
			"import": "./dist/react.js"
		},
		"./site": {
			"types": "./dist/site.d.ts",
			"import": "./dist/site.js"
		},
		"./serve": {
			"types": "./dist/serve.d.ts",
			"import": "./dist/serve.js"
		},
		"./cloudflare": {
			"types": "./dist/cloudflare.d.ts",
			"import": "./dist/cloudflare.js"
		},
		"./better-auth": {
			"types": "./dist/better-auth.d.ts",
			"import": "./dist/better-auth.js"
		},
		"./admin-client": {
			"types": "./dist/admin-client.d.ts",
			"import": "./dist/admin-client.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"setup:admin": "./scripts/fetch-admin.sh",
		"build": "NODE_OPTIONS=--max-old-space-size=6144 tsup",
		"test": "bun test ./test --timeout 20000 && bun run test:dom",
		"test:dom": "bun test ./test/react-dom.dom.tsx && bun test ./test/admin-client.dom.tsx",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"liquidjs": "^10.30.0",
		"zod": "^4.4.3"
	},
	"peerDependencies": {
		"@tbtop/admin": "*",
		"better-auth": "^1.7.0",
		"@tbtop/inertia-admin": "^0.7.3",
		"kysely": "^0.28.0",
		"@json-render/core": "^0.19.0",
		"@json-render/react": "^0.19.0",
		"react": "^19.0.0"
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "^20.10.6",
		"@json-render/core": "^0.19.0",
		"@json-render/react": "^0.19.0",
		"@tbtop/admin": "file:.tbtop/packages/node",
		"@tbtop/inertia-admin": "^0.7.3",
		"@testing-library/react": "^16.3.2",
		"@types/bun": "^1.3.11",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"better-auth": "1.7.12",
		"kysely": "^0.28.2",
		"kysely-bun-sqlite": "^0.4.0",
		"mysql2": "^3.24.6",
		"pg": "^8.23.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tsup": "^8.5.0",
		"typescript": "^5.9.0"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE.md"
	],
	"peerDependenciesMeta": {
		"@json-render/core": {
			"optional": true
		},
		"@json-render/react": {
			"optional": true
		},
		"@tbtop/inertia-admin": {
			"optional": true
		},
		"better-auth": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}

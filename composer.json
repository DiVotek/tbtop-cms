{
    "name": "tbtop/cms",
    "description": "Minimal tbtop + json-render CMS core for Laravel.",
    "keywords": [
        "Tbtop",
        "laravel",
        "cms",
        "json-render"
    ],
    "homepage": "https://github.com/DiVotek/tbtop-cms",
    "support": {
        "issues": "https://github.com/DiVotek/tbtop-cms/issues",
        "source": "https://github.com/DiVotek/tbtop-cms"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "DiVotek",
            "email": "support@divotek.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "illuminate/contracts": "^11.0||^12.0||^13.0",
        "inertiajs/inertia-laravel": "^3.1",
        "phpstan/phpdoc-parser": "^2.0",
        "spatie/laravel-package-tools": "^1.16",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-translatable": "^6.14",
        "tbtop/admin": "^0.7.3"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "laravel/sanctum": "^4.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0||^10.0||^11.0",
        "pestphp/pest": "^3.7||^4.0",
        "pestphp/pest-plugin-arch": "^3.0||^4.0",
        "pestphp/pest-plugin-laravel": "^3.0||^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-phpunit": "^2.0",
        "rector/rector": "^2.0"
    },
    "suggest": {
        "laravel/sanctum": "Required for the token-authenticated pages API (tbtop-cms.api)."
    },
    "autoload": {
        "psr-4": {
            "Tbtop\\Cms\\": "src/",
            "Tbtop\\Cms\\Database\\Factories\\": "database/factories/",
            "Tbtop\\Cms\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tbtop\\Cms\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "analyse": "phpstan analyse",
        "analyse:changed": "{ git diff --name-only --diff-filter=ACMR HEAD; git ls-files --others --exclude-standard; } | grep -E '^(src|config|database)/.*\\.php$' | xargs -r phpstan analyse",
        "lint": "pint",
        "lint:changed": "{ git diff --name-only --diff-filter=ACMR HEAD; git ls-files --others --exclude-standard; } | grep '\\.php$' | xargs -r pint",
        "test:lint": "pint --test",
        "test:lint:changed": "{ git diff --name-only --diff-filter=ACMR HEAD; git ls-files --others --exclude-standard; } | grep '\\.php$' | xargs -r pint --test",
        "refactor": "rector",
        "refactor:changed": "{ git diff --name-only --diff-filter=ACMR HEAD; git ls-files --others --exclude-standard; } | grep -E '^(src|config|database)/.*\\.php$' | xargs -r rector process",
        "test:refactor": "rector --dry-run",
        "test:refactor:changed": "{ git diff --name-only --diff-filter=ACMR HEAD; git ls-files --others --exclude-standard; } | grep -E '^(src|config|database)/.*\\.php$' | xargs -r rector process --dry-run",
        "test": "pest --parallel",
        "test:mysql": "TBTOP_TEST_DB=mysql LARAVEL_PARALLEL_TESTING=1 CACHE_STORE=array QUEUE_CONNECTION=sync pest --parallel",
        "test:changed": "{ git diff --name-only --diff-filter=ACMR HEAD -- tests; git ls-files --others --exclude-standard -- tests; } | grep '\\.php$' | xargs -r pest",
        "test:coverage": "pest --coverage",
        "test:all:changed": [
            "@test:lint:changed",
            "@analyse:changed",
            "@test:refactor:changed",
            "@test:changed"
        ],
        "types:blocks": "@php bin/generate-block-types.php",
        "types:blocks:check": "@php bin/generate-block-types.php --check",
        "verify": [
            "Composer\\Config::disableProcessTimeout",
            "bin/verify"
        ],
        "hooks": "git config core.hooksPath bin/git-hooks"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tbtop\\Cms\\CmsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
